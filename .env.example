# ONCOGUARD AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# LLM Provider Configuration (Optional - for AI Assistant online mode)
# =============================================================================

# OpenAI API Key (get from https://platform.openai.com/api-keys)
# Required for online assistant mode. Without this, assistant runs in offline mode.
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (default: gpt-4o-mini)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# OpenAI Base URL (optional - for compatible APIs like Azure, local proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# Streamlit Configuration (Optional)
# =============================================================================

# Server port (default: 8501)
# STREAMLIT_SERVER_PORT=8501

# Run headless (default: false)
# STREAMLIT_SERVER_HEADLESS=false

# =============================================================================
# Other Configuration (Optional)
# =============================================================================

# Random seed for reproducibility (default: 42)
# RANDOM_SEED=42

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO