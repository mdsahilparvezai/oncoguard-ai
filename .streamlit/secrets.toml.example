# ONCOGUARD AI - Streamlit Secrets Template
# Copy this file to .streamlit/secrets.toml and fill in your values
# NEVER commit secrets.toml to version control!

# OpenAI API Key for AI Assistant (optional - enables online mode)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY = "your_openai_api_key_here"

# OpenAI Model (optional - default: gpt-4o-mini)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL = "gpt-4o-mini"

# OpenAI Base URL (optional - for compatible APIs)
# OPENAI_BASE_URL = "https://api.openai.com/v1"

# Streamlit Server Config (optional)
# SERVER_PORT = 8501
# SERVER_HEADLESS = false